---
import { FileText, History, Settings2, Plus, RotateCcw, ArrowUpRight, Trash2, Check, Sheet, ExternalLink, Share2, Download, Copy, X, Pencil } from 'lucide';
const icons = { invoice: FileText, history: History, settings: Settings2, plus: Plus, reset: RotateCcw, arrow: ArrowUpRight, trash: Trash2, check: Check, sheet: Sheet, external: ExternalLink, share: Share2, download: Download, copy: Copy, close: X, edit: Pencil };
type Props = { name: keyof typeof icons; class?: string };
const { name, class: className } = Astro.props;
---
<svg class={className} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{icons[name].map(([tag, attributes]) => { const Tag = tag; return <Tag {...attributes} />; })}</svg>
